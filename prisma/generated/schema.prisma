generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

///////////////////////
// ENUMS
///////////////////////

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  ORACLE
  SQLSERVER
  SQLITE
}

///////////////////////
// CORE MODELS
///////////////////////

model User {
  id                    String   @id @unique
  name                  String
  email                 String   @unique
  password              String
  emailVerified         Boolean?
  image                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  hasCompleteOnboarding Boolean  @default(false)

  memberships WorkspaceMember[]
  activities  ActivityLog[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    WorkspaceMember[]
  dataModels DataModel[]

  @@map("workspaces")
}

model WorkspaceSlug {
  base  String @id
  count Int

  @@map("workspace_slugs")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

///////////////////////
// DATA MODEL
///////////////////////

model DataModel {
  id           String       @id @default(uuid())
  name         String
  description  String?
  isPinned     Boolean      @default(false)
  isPublic     Boolean      @default(false)
  previewColor String?
  dbType       DatabaseType
  workspaceId  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags          DataModelTag[]
  tables        Table[]
  relationships Relationship[]
  views         View[]
  procedures    Procedure[]
  diagrams      Diagram[]
  checkpoints   Checkpoint[]
  activities    ActivityLog[]

  @@index([workspaceId])
  @@map("data_models")
}

///////////////////////
// TAG SYSTEM (FIXED)
///////////////////////

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataModels DataModelTag[]

  @@map("tags")
}

model DataModelTag {
  dataModelId String
  tagId       String

  dataModel DataModel @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dataModelId, tagId])
  @@index([tagId])
  @@index([dataModelId])
  @@map("data_model_tags")
}

///////////////////////
// TABLE STRUCTURE
///////////////////////

model Table {
  id          String   @id @default(uuid())
  name        String
  dataModelId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataModel DataModel   @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  columns   Column[]
  indexes   Index[]
  triggers  Trigger[]
  nodes     TableNode[]

  @@index([dataModelId])
  @@map("tables")
}

model Column {
  id              String  @id @default(uuid())
  tableId         String
  name            String
  type            String
  length          Int?
  precision       Int?
  scale           Int?
  isNullable      Boolean @default(true)
  default         String?
  isUnique        Boolean @default(false)
  isPrimaryKey    Boolean @default(false)
  isAutoIncrement Boolean @default(false)
  isUnsigned      Boolean @default(false)
  customType      String?

  table           Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sourceRelations Relationship[] @relation("SourceColumn")
  targetRelations Relationship[] @relation("TargetColumn")

  @@index([tableId])
  @@map("columns")
}

model Relationship {
  id             String @id @default(uuid())
  dataModelId    String
  sourceColumnId String
  targetColumnId String
  onDelete       String
  onUpdate       String

  dataModel    DataModel @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  sourceColumn Column    @relation("SourceColumn", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  targetColumn Column    @relation("TargetColumn", fields: [targetColumnId], references: [id], onDelete: Cascade)

  @@index([dataModelId])
  @@map("relationships")
}

model Index {
  id      String   @id @default(uuid())
  tableId String
  name    String
  type    String
  columns String[]

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("indexes")
}

///////////////////////
// VIEW / TRIGGER / PROCEDURE
///////////////////////

model View {
  id                String   @id @default(uuid())
  dataModelId       String
  name              String
  sql               String
  primaryIdentifier String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dataModel DataModel        @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  versions  VersionHistory[]

  @@index([dataModelId])
  @@map("views")
}

model Trigger {
  id        String   @id @default(uuid())
  tableId   String
  name      String
  event     String
  timing    String
  body      String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table    Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  versions VersionHistory[]

  @@index([tableId])
  @@map("triggers")
}

model Procedure {
  id              String   @id @default(uuid())
  dataModelId     String
  name            String
  description     String?
  language        String
  securityType    String
  dataAccess      String
  isDeterministic Boolean  @default(false)
  body            String
  parameters      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dataModel DataModel        @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  versions  VersionHistory[]

  @@index([dataModelId])
  @@map("procedures")
}

///////////////////////
// DIAGRAM
///////////////////////

model Diagram {
  id          String   @id @default(uuid())
  dataModelId String
  name        String
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataModel DataModel   @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  nodes     TableNode[]
  groups    Group[]
  notes     Note[]

  @@index([dataModelId])
  @@map("diagrams")
}

model TableNode {
  id        String @id @default(uuid())
  diagramId String
  tableId   String
  x         Float
  y         Float

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  table   Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([diagramId, tableId])
  @@index([tableId])
  @@map("table_nodes")
}

model Group {
  id        String @id @default(uuid())
  diagramId String
  name      String
  color     String
  x         Float
  y         Float
  width     Float
  height    Float

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId])
  @@map("groups")
}

model Note {
  id        String @id @default(uuid())
  diagramId String
  content   String
  x         Float
  y         Float

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId])
  @@map("notes")
}

///////////////////////
// HISTORY / LOG
///////////////////////

model Checkpoint {
  id          String   @id @default(uuid())
  dataModelId String
  name        String
  snapshot    Json
  createdAt   DateTime @default(now())

  dataModel DataModel @relation(fields: [dataModelId], references: [id], onDelete: Cascade)

  @@index([dataModelId])
  @@map("checkpoints")
}

model ActivityLog {
  id          String   @id @default(uuid())
  dataModelId String
  userId      String
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  dataModel DataModel @relation(fields: [dataModelId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dataModelId])
  @@index([userId])
  @@map("activity_logs")
}

model VersionHistory {
  id          String   @id @default(uuid())
  viewId      String?
  triggerId   String?
  procedureId String?
  version     Int
  snapshot    Json
  userId      String
  createdAt   DateTime @default(now())

  view      View?      @relation(fields: [viewId], references: [id], onDelete: Cascade)
  trigger   Trigger?   @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("version_histories")
}
